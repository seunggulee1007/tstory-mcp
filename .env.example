# 세션 쿠키 파일 (Playwright storageState 형식). 기본값: .secrets/state.json
TISTORY_STATE_FILE=.secrets/state.json
# 사용할 블로그 이름 (예: myblog). 비우면 내 블로그 중 기본 블로그
TISTORY_BLOG=
# 배치 알림용 Dooray 인커밍 웹훅 URL. 비우면 stdout 으로만 출력
NOTIFY_WEBHOOK_URL=
# 1 이면 수정안 브랜치를 origin 에 push (제안만 올림, 머지는 사람이)
REPAIR_PUSH=0
# 1 이면 헬스체크가 이미지 업로드도 검사 (블로그에 파일이 남으므로 기본 0, 주 1회 정도만 켜기 권장)
HEALTHCHECK_UPLOAD=0
# 수정안 생성 시 claude 비용 상한(USD). ANTHROPIC_API_KEY 가 있으면 격리된 실행에도 전달됨
REPAIR_MAX_BUDGET_USD=3
